{
  "name": "bili-live-listener",
  "type": "module",
  "version": "1.0.5",
  "packageManager": "pnpm@10.28.0",
  "description": "Bilibili直播间消息监听库。",
  "author": "Lu-Jiejie <lu-jiejie@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/Lu-Jiejie/bili-live-listener#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lu-Jiejie/bili-live-listener.git"
  },
  "bugs": "https://github.com/Lu-Jiejie/bili-live-listener/issues",
  "keywords": [
    "bilibili",
    "live",
    "danmu"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --stub",
    "build": "tsdown",
    "lint": "eslint .",
    "release": "bumpp && npm publish",
    "start": "tsx src/start.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "bilibili-live-ws": "^6.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.1",
    "@types/node": "^20.19.29",
    "bumpp": "^10.4.0",
    "eslint": "^9.39.2",
    "lint-staged": "^16.2.7",
    "publint": "^0.3.16",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
